# Hugo build output is produced by GitHub Actions, never committed
public/
.hugo_build.lock

# Episode audio lives in Cloudflare R2 (uploaded by tools/make_episode.py),
# so the repo and the published site stay small.
static/audio/

# Pipeline tools (tools/): the large dictionary table and scratch data are not
# committed — see the note in tools/make_episode.py for how to fetch ECDICT.
tools/ecdict.csv
tools/a2_chunks/
tools/__pycache__/

# Android app (android/): the source is committed, build output and the
# machine-specific SDK path are not.
android/.gradle/
android/build/
android/app/build/
android/local.properties

# tmp
arXiv-2412.15408v1
arXiv-2111.09958v2

# Scratch clones (tools/build_exercises.py keeps the upstream exercises-dataset
# here — 295 MB including media — and commits only the trimmed data file).
.scratch/

# Local clone of IB2d (immersed boundary method), not part of the site
IB2d/

# macOS
.DS_Store
